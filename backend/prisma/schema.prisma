generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// SaaS eke inna Companies (Tenants)
model Company {
  id        String     @id @default(uuid())
  name      String
  domain    String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  // Relations
  users     User[]
  customers Customer[]
  invoices  Invoice[]  // Aluthen add kala
}

// System eka use karana Users (Admins, Sales Reps)
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   
  name      String
  role      Role     @default(USER)
  
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// CRM eke inna Clients/Leads
model Customer {
  id        String     @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  status    LeadStatus @default(NEW)
  
  companyId String
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices  Invoice[]  // Aluthen add kala

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// ==========================================
// ALUTH: Invoices Module Schema
// ==========================================

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  
  subTotal      Float         @default(0)
  taxRate       Float         @default(0)
  totalAmount   Float         @default(0)
  notes         String?       @db.Text

  // Multi-tenant & Customer relations
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  items         InvoiceItem[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([invoiceNumber, companyId]) // Eka company ekakata eka invoice number eka ekaparai thiyenna puluwan
}

model InvoiceItem {
  id          String   @id @default(uuid())
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  total       Float

  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}